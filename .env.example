# Copie este arquivo para `.env` e troque todos os valores antes de subir o
# sistema fora da sua máquina de desenvolvimento (RNF-06: segurança).

# --- Banco de dados (papel administrador, dono do schema, roda migrações) ---
POSTGRES_USER=siscoord
POSTGRES_PASSWORD=troque-esta-senha-admin
POSTGRES_DB=siscoord

# Papel restrito que a API efetivamente usa em tempo de execução — sem
# permissão de escrita na tabela de auditoria (RF-13). Também usado pelo
# GeoServer para ler o mesmo banco (RNF-01: um SGBD só).
APP_DB_PASSWORD=troque-esta-senha-app

# Chave de assinatura dos tokens JWT — gere algo longo e aleatório, por
# exemplo: openssl rand -hex 32
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-longa

# --- Primeiro usuário Coordenador (criado automaticamente no primeiro boot) --
# ADMIN_EMAIL precisa ser um e-mail válido de verdade: a API valida o formato
# com email-validator, que rejeita domínios reservados como .local/.test.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@siscoorddc.gov.br
ADMIN_SENHA=troque-esta-senha-admin-123

# --- GeoServer (publica WMS/WFS — RF-11) -------------------------------------
GEOSERVER_ADMIN_USER=admin
GEOSERVER_ADMIN_PASSWORD=troque-esta-senha-geoserver

# Opcional: porta local do console do GeoServer (padrão 8080). Troque se a
# 8080 já estiver em uso na máquina, ex.: GEOSERVER_PORTA_HOST=8081
# GEOSERVER_PORTA_HOST=8080
